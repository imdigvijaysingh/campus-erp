# Multi-stage Hardened Production Dockerfile
# Enforces Container Immutability & Non-Root Execution (UID 10001)

# Stage 1: Dependency Builder
FROM node:22-alpine AS builder
WORKDIR /app
COPY backend/package*.json ./
RUN npm ci --only=production

# Stage 2: Hardened Runtime
FROM node:22-alpine AS runner
WORKDIR /app

# Create non-root system group and user (UID/GID 10001)
RUN addgroup -g 10001 -S shyvora && \
    adduser -u 10001 -S shyvora -G shyvora

# Copy production node_modules from builder
COPY --from=builder --chown=root:root /app/node_modules ./node_modules
COPY --chown=root:root backend/ ./

# Secure file permissions (read-only application source)
RUN chmod -R 555 /app && \
    chmod -R 555 /app/node_modules

# Ensure /tmp has correct sticky permissions for memory-backed scratch space
RUN chmod 1777 /tmp

# Drop all privileges
USER 10001:10001

ENV NODE_ENV=production
ENV PORT=5000

EXPOSE 5000

# Health check probe
HEALTHCHECK --interval=10s --timeout=2s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:5000/health || exit 1

CMD ["node", "server.js"]
